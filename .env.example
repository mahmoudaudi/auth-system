# ---- Database ----
DATABASE_URL=postgresql://auth_app:your_secure_password_here@localhost:5432/auth_system

# ---- JWT ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_me_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- First admin (used only by: python -m app.create_admin) ----
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE_NUMBER=+9613000000
ADMIN_CITY=Tripoli
ADMIN_AGE=30
ADMIN_PASSWORD=ChangeMe123!
